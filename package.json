{
  "name": "@remote-fill/core",
  "version": "0.11.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.mobile.json --noEmit && npm test",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/server.js",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "stress:security": "npm run build && node scripts/security-stress.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
